# Copy to prod.env and fill in every REPLACE_ME.
#   cp prod.env.example prod.env
# prod.env is gitignored (*.env). Comments must be on their own line --
# docker compose does not strip trailing comments from env_file values.

# --- Public hostname -------------------------------------------------------
# Must match the public hostname you point the Cloudflare tunnel at.
PHX_HOST=tools.snowse.io
OIDC_REDIRECT_URI=https://tools.snowse.io/auth/callback

# --- Phoenix ---------------------------------------------------------------
# Reuse the old value from the k8s secret so existing sessions/cookies survive,
# or generate a new one with: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=REPLACE_ME

# --- Postgres --------------------------------------------------------------
# DATABASE_URL is assembled from these in docker-compose.prod.yml -- do not set
# it here. Keep the password URL-safe (no @ : / ? # characters).
POSTGRES_USER=syllabus_user
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=snow_se_tools

# --- OIDC ------------------------------------------------------------------
# e.g. https://keycloak.example.com/realms/myrealm
OIDC_ISSUER=REPLACE_ME
# Keycloak identity-provider alias to jump straight to (optional)
OIDC_IDP_HINT=
OIDC_CLIENT_ID=REPLACE_ME

# --- AI --------------------------------------------------------------------
# OpenAI-compatible /v1/chat/completions endpoint
AI_ENDPOINT=REPLACE_ME
AI_API_KEY=REPLACE_ME
AI_MODEL=qwen3-6-35b-q6

# --- Discord ---------------------------------------------------------------
DISCORD_BOT_TOKEN=REPLACE_ME
DISCORD_GUILD_ID=REPLACE_ME

# --- Cloudflare ------------------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> install token
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME
