{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchFileNames": ["k8s/base/app.yaml"],
      "automerge": true
    }
  ],
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
