<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="flex flex-col items-center justify-center py-24 text-center px-4">
    <h1 class="text-3xl font-bold text-slate-100 mb-4">Snow SE Tools</h1>
    <.link
      id="landing-log-in"
      href="/auth/login?return_to=%2Fhome"
      class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-400"
    >
      Log in
    </.link>
  </div>
</Layouts.app>
